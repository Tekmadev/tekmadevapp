# API mode: "mock" (default, uses src/api/mock fixtures) or "live".
EXPO_PUBLIC_API_MODE=mock
# Admin API base URL (used when EXPO_PUBLIC_API_MODE=live).
EXPO_PUBLIC_API_BASE=https://www.tekmadev.com/api/admin/v1
# Auth mode: "mock" (fixture staff accounts) or "supabase" (real sign-in).
EXPO_PUBLIC_AUTH_MODE=mock
# Supabase project URL and publishable (anon) key. Used for sign-in only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
